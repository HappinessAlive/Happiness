local lightingGroupbox = Tabs.Visuals:AddRightGroupbox("Lighting", "flashlight")

lightingGroupbox:AddToggle("fbEnabled", {
    Text = "Fullbright",
    Tooltip = "Toggles fullbright",
    Default = false,
    Callback = function(Value)
        if Value then
            config.defaultAmbient = Lighting.Ambient
            config.defaultOutdoorAmbient = Lighting.OutdoorAmbient
            config.defaultBrightness = Lighting.Brightness
            config.defaultClockTime = Lighting.ClockTime
            config.defaultFogStart = Lighting.FogStart
            config.defaultFogEnd = Lighting.FogEnd

            applyFullbright()

            local function connectLighting()
                lightingConnection = Lighting.Changed:Connect(function(property)
                    if Toggles.fbEnabled and Toggles.fbEnabled.Value then
                        if property == "Ambient" or property == "OutdoorAmbient" or property == "Brightness" or property == "ClockTime" or property == "FogEnd" or property == "FogStart" then
                            lightingConnection:Disconnect()
                            applyFullbright()
                            connectLighting()
                        end
                    end
                end)
            end
            
            connectLighting()
        else

            if lightingConnection then
                lightingConnection:Disconnect()
                lightingConnection = nil
            end

            Lighting.Ambient = config.defaultAmbient
            Lighting.OutdoorAmbient = config.defaultOutdoorAmbient
            Lighting.Brightness = config.defaultBrightness
            Lighting.ClockTime = config.defaultClockTime
            Lighting.FogStart = config.defaultFogStart
            Lighting.FogEnd = config.defaultFogEnd
        end
    end
})

