-- loops and respawns
RunService.RenderStepped:Connect(function()
	if Toggles.ThirdPerson and Toggles.ThirdPerson.Value then
		if plr.CameraMode ~= Enum.CameraMode.Classic then
			plr.CameraMode = Enum.CameraMode.Classic
		end
		if plr.CameraMaxZoomDistance < 15 then
			plr.CameraMaxZoomDistance = 15
		end
	end
end)

plr.CharacterAdded:Connect(function(char)
	task.wait(1)
	local clientScripts = char:WaitForChild("ClientScripts", 10)
	local stagger = clientScripts and clientScripts:WaitForChild("Stagger", 10)
	if stagger then
		stagger.Disabled = not config.staggerEnabled
	end
	applyNametags(char)
	applyInfection(char)
	if Toggles.ThirdPerson and Toggles.ThirdPerson.Value then
		plr.CameraMode = Enum.CameraMode.Classic
		plr.CameraMaxZoomDistance = 15
	end
end)

