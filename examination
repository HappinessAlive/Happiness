local function createESP(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local highlight = Instance.new("Highlight", char)
    highlight.DepthMode = "AlwaysOnTop"
    highlight.FillTransparency = 0.75
    highlight.OutlineTransparency = 1
    local billboard = Instance.new("BillboardGui", char)
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.AlwaysOnTop = true
    local label = Instance.new("TextLabel", billboard)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextStrokeTransparency = 0
    label.TextColor3 = Color3.new(1, 1, 1)
    RunService.RenderStepped:Connect(function()
        if not char.Parent then return end
        local isEnabled = Toggles.espEnabled and Toggles.espEnabled.Value
        highlight.Enabled = isEnabled or false
        billboard.Enabled = isEnabled or false
        if isEnabled then
            highlight.FillColor = Players:GetPlayerFromCharacter(char) and config.plrColor or config.npcColor
            label.Text = char.Name .. " [HP: " .. math.floor(hum.Health) .. "]"
        end
    end)
end

workspace.Characters.ChildAdded:Connect(createESP)
for _, v in ipairs(workspace.Characters:GetChildren()) do task.spawn(createESP, v) end

local function applyFullbright()
