local function applyInfection(char)
    if not char then return end
    local head = char:WaitForChild("Head", 10)
    if not head then return end
    
    local leftEye = head:WaitForChild("InfectedLeft", 5)
    local rightEye = head:WaitForChild("InfectedRight", 5)

    local isEnabled = Toggles.infectionToggle and Toggles.infectionToggle.Value or false

    if leftEye and leftEye:FindFirstChild("ParticleEmitter") then
        leftEye.ParticleEmitter.Enabled = isEnabled
        leftEye.ParticleEmitter.Color = ColorSequence.new(config.eyesColor)
    end

    if rightEye and rightEye:FindFirstChild("ParticleEmitter") then
        rightEye.ParticleEmitter.Enabled = isEnabled
        rightEye.ParticleEmitter.Color = ColorSequence.new(config.eyesColor)
    end
end

